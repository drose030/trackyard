{
  "name": "trackyard-desktop",
  "productName": "Trackyard",
  "version": "1.2.0",
  "description": "Turn songs into playable drum charts for Beat-Train and Clone Hero",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "bundle": "uv run --no-project --python 3.11 scripts/bundle.py",
    "smoke": "node scripts/smoke.js",
    "dist": "npm run bundle && npm run smoke && electron-builder --publish never"
  },
  "build": {
    "appId": "io.github.drose030.trackyard",
    "productName": "Trackyard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "build/python",
        "to": "python"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Trackyard-${version}-${arch}.dmg"
    },
    "dmg": {
      "title": "Trackyard"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Trackyard-Setup-${version}.exe"
    },
    "afterPack": "scripts/adhoc-sign.js"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  }
}
